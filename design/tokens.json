{
  "$description": "ShipQuick neutral tokens (story #182). W3C Design Tokens format ($value, $type). No brand: a child overrides these in its own tokens file. `feel` is shared by Android and iOS so both apps feel the same (rule 38).",
  "color": {
    "$type": "color",
    "background": {"$value": "#FFFFFF"},
    "surface": {"$value": "#F5F5F5"},
    "onSurface": {"$value": "#1A1A1A"},
    "onSurfaceMuted": {"$value": "#595959"},
    "outline": {"$value": "#8C8C8C"},
    "primary": {"$value": "#1A1A1A"},
    "onPrimary": {"$value": "#FFFFFF"},
    "error": {"$value": "#B3261E"},
    "onError": {"$value": "#FFFFFF"}
  },
  "typography": {
    "fontFamily": {"$type": "fontFamily", "$value": "system-ui", "$description": "Roboto on Android, SF Pro on iOS: each platform's own system font."},
    "size": {
      "$type": "dimension",
      "small": {"$value": "12sp"},
      "body": {"$value": "16sp"},
      "title": {"$value": "22sp"},
      "headline": {"$value": "28sp"}
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {"$value": 400},
      "medium": {"$value": 500},
      "bold": {"$value": 700}
    }
  },
  "spacing": {
    "$type": "dimension",
    "xs": {"$value": "4dp"},
    "sm": {"$value": "8dp"},
    "md": {"$value": "16dp"},
    "lg": {"$value": "24dp"},
    "xl": {"$value": "32dp"}
  },
  "shape": {
    "$type": "dimension",
    "radiusSmall": {"$value": "4dp"},
    "radiusMedium": {"$value": "12dp"},
    "radiusLarge": {"$value": "16dp"},
    "radiusFull": {"$value": "9999dp"}
  },
  "feel": {
    "$description": "How the app moves and answers a touch. dp on Android equals pt on iOS.",
    "motion": {
      "duration": {
        "$type": "duration",
        "short": {"$value": "100ms", "$description": "A press or a toggle."},
        "medium": {"$value": "250ms", "$description": "A sheet or a dialog opens."},
        "long": {"$value": "400ms", "$description": "A full screen change."}
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {"$value": [0.2, 0.0, 0.0, 1.0]},
        "enter": {"$value": [0.05, 0.7, 0.1, 1.0]},
        "exit": {"$value": [0.3, 0.0, 0.8, 0.15]}
      }
    },
    "haptics": {
      "$description": "One meaning, the closest call on each platform: Android HapticFeedbackConstants, iOS UIFeedbackGenerator.",
      "press": {"$value": {"android": "VIRTUAL_KEY", "ios": "impact.light"}},
      "success": {"$value": {"android": "CONFIRM", "ios": "notification.success"}},
      "error": {"$value": {"android": "REJECT", "ios": "notification.error"}}
    },
    "touchTarget": {
      "$type": "dimension",
      "$description": "The smallest pressable area. Android Material: 48dp. Apple HIG: 44pt.",
      "android": {"$value": "48dp"},
      "ios": {"$value": "44pt"}
    }
  }
}
